// PatientEvoPhysio 2.0.0 - OpenModelica dependency installer
// Requires an Internet connection unless the packages are already cached/installed.
// This script does not modify PatientEvoPhysio source code.

updatePackageIndex();
getErrorString();

// Install the Modelica Standard Library version required by PatientEvoPhysio.
// exactMatch=false allows an OpenModelica-maintained backwards-compatible 3.2.3 provider.
installPackage(Modelica, "3.2.3", exactMatch=false);
getErrorString();

// Install the exact Physiolibrary release used by PatientEvoPhysio.
// OpenModelica's Package Manager also installs dependencies of Physiolibrary.
installPackage(Physiolibrary, "2.3.1", exactMatch=true);
getErrorString();

// Verify that the requested libraries can now be loaded.
loadModel(Modelica, {"3.2.3"});
getErrorString();
loadModel(Physiolibrary, {"2.3.1"});
getErrorString();
