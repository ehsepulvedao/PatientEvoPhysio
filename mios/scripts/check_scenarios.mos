// PatientEvoPhysio v2 compile/flatten checks
// Run from repository root after configuring Modelica 3.2.3 + Physiolibrary 2.3.1.
clear();
loadModel(Modelica, {"3.2.3"}, true, "", true);
print(getErrorString());
loadModel(Physiolibrary, {"2.3.1"}, true, "", true);
print(getErrorString());
loadFile("PatientEvoPhysio.mo", "UTF-8", false, true, false, true);
print(getErrorString());

print("\n=== CHECK Adult.Healthy ===\n");
print(checkModel(PatientEvoPhysio.Scenarios.Adult.Healthy)); print(getErrorString(true));
print("\n=== CHECK Child.Healthy ===\n");
print(checkModel(PatientEvoPhysio.Scenarios.Child.Healthy)); print(getErrorString(true));
print("\n=== CHECK Child.Stenosis ===\n");
print(checkModel(PatientEvoPhysio.Scenarios.Child.Stenosis)); print(getErrorString(true));
print("\n=== CHECK Neonate.Healthy ===\n");
print(checkModel(PatientEvoPhysio.Scenarios.Neonate.Healthy)); print(getErrorString(true));
print("\n=== CHECK Neonate.Stenosis ===\n");
print(checkModel(PatientEvoPhysio.Scenarios.Neonate.Stenosis)); print(getErrorString(true));
print("\n=== CHECK Neonate.Coarctation_of_the_Aorta ===\n");
print(checkModel(PatientEvoPhysio.Scenarios.Neonate.Coarctation_of_the_Aorta)); print(getErrorString(true));
print("\n=== CHECK Neonate.Tetralogy_of_Fallot ===\n");
print(checkModel(PatientEvoPhysio.Scenarios.Neonate.Tetralogy_of_Fallot)); print(getErrorString(true));
print("\n=== CHECK Neonate.Transposition_of_the_Great_Arteries ===\n");
print(checkModel(PatientEvoPhysio.Scenarios.Neonate.Transposition_of_the_Great_Arteries)); print(getErrorString(true));
print("\n=== CHECK Neonate.Persistence_of_Ductus_Arteriosus ===\n");
print(checkModel(PatientEvoPhysio.Scenarios.Neonate.Persistence_of_Ductus_Arteriosus)); print(getErrorString(true));
print("\n=== CHECK Fetus.FetalToNeonatal_Transition ===\n");
print(checkModel(PatientEvoPhysio.Scenarios.Fetus.FetalToNeonatal_Transition)); print(getErrorString(true));

print("\nScenario checks completed.\n");
