// Five-second neonatal smoke simulation with CSV output.
clear();
loadModel(Modelica, {"3.2.3"}, true, "", true);
loadModel(Physiolibrary, {"2.3.1"}, true, "", true);
loadFile("PatientEvoPhysio.mo", "UTF-8", false, true, false, true);
print(getErrorString());
print(checkModel(PatientEvoPhysio.Scenarios.Neonate.Healthy));
print(getErrorString(true));
simulate(PatientEvoPhysio.Scenarios.Neonate.Healthy,
  startTime=0,
  stopTime=5,
  numberOfIntervals=5000,
  method="dassl",
  tolerance=1e-6,
  outputFormat="csv",
  fileNamePrefix="neonate_healthy_smoke");
print(getErrorString(true));
